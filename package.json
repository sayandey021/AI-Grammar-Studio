{
  "name": "ai-grammar-studio",
  "productName": "AI Grammar Studio",
  "version": "1.0.0",
  "description": "AI Grammar Studio - Private, offline-first intelligent writing assistant",
  "main": "out/main/index.js",
  "author": "Saayan",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p tsconfig.node.json --watch\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "compile:main": "tsc -p tsconfig.node.json",
    "compile:renderer": "vite build",
    "compile": "tsc -p tsconfig.node.json && vite build",
    "build": "npm run compile && electron-builder",
    "build:exe": "npm run compile && electron-builder --win nsis",
    "build:msix": "npm run compile && electron-builder --win appx",
    "build:all": "npm run compile && electron-builder --win nsis appx",
    "set-version": "node scripts/set-version.js",
    "test": "vitest"
  },
  "build": {
    "appId": "Saayan.AIGrammerStudio",
    "productName": "AI Grammar Studio",
    "executableName": "ai-grammar-studio",
    "compression": "normal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "assets/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!**/.cache/**",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/@xenova/transformers/.cache/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/win32/ia32/**"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "executableName": "ai-grammar-studio",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Grammar Studio"
    },
    "appx": {
      "artifactName": "${productName}-${version}-${arch}.msix",
      "identityName": "Saayan.AIGrammerStudio",
      "publisher": "CN=37E2AF47-D2FC-489C-BDC1-02C989A7B989",
      "publisherDisplayName": "Saayan",
      "applicationId": "Saayan.AIGrammerStudio",
      "displayName": "AI Grammar Studio",
      "backgroundColor": "#070a13",
      "languages": [
        "en-US"
      ],
      "showNameOnTiles": true,
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.22621.0"
    }
  },
  "keywords": [
    "grammar-checker",
    "spell-checker",
    "electron",
    "react",
    "onnx",
    "ai",
    "local-ai",
    "offline-first",
    "directml",
    "writing-assistant"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sayandey021/AI-Grammar-Studio.git"
  },
  "bugs": {
    "url": "https://github.com/sayandey021/AI-Grammar-Studio/issues"
  },
  "homepage": "https://github.com/sayandey021/AI-Grammar-Studio#readme",
  "license": "GPL-3.0",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "compromise": "^14.16.0",
    "dictionary-en": "^4.0.0",
    "nspell": "^2.1.5",
    "onnxruntime-node": "^1.21.0",
    "write-good": "^1.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/nspell": "^2.1.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/write-good": "^1.0.3",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "onnxruntime-node": "^1.21.0"
  }
}
