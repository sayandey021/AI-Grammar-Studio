{
  "compilerOptions": {
    "target": "ES2022",
    "composite": true,
    "skipLibCheck": true,
    "module": "commonjs",
    "allowSyntheticDefaultImports": true,
    "rootDir": "src/main",
    "outDir": "out/main"
  },
  "include": ["src/main/**/*"],
  "exclude": ["src/main/**/*.test.ts", "src/main/**/__tests__/*"]
}
